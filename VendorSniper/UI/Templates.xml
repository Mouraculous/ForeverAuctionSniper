<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!--
	One result row. Visuals match the Auction House list rows
	(auctionhouse-rowstripe-1 / row-highlight atlases). The numeric column
	cells are created in VendorSniperResultRowMixin:OnLoad from
	ns.ResultsView.COLUMNS, so columns are defined in one place only.
	-->
	<Button name="VendorSniperResultRowTemplate" mixin="VendorSniperResultRowMixin" registerForClicks="LeftButtonUp, RightButtonUp" virtual="true">
		<Size x="0" y="32"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="24" y="24"/>
					<Anchors>
						<Anchor point="LEFT" x="6" y="0"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Name" inherits="GameFontNormal" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="TOPRIGHT" x="6" y="0"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Detail" inherits="GameFontDisableSmall" justifyH="LEFT" wordwrap="false">
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeKey="$parent.Icon" relativePoint="BOTTOMRIGHT" x="6" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="IconBorder" atlas="auctionhouse-itemicon-small-border">
					<Size x="26" y="26"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Icon"/>
					</Anchors>
				</Texture>
				<Texture parentKey="HighlightTexture" atlas="auctionhouse-ui-row-highlight" alphaMode="ADD" setAllPoints="true" hidden="true"/>
			</Layer>
		</Layers>
		<NormalTexture parentKey="NormalTexture" atlas="auctionhouse-rowstripe-1" setAllPoints="true"/>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<!-- Sortable column header: Blizzard's column-tab art plus the AH sort arrow. -->
	<Button name="VendorSniperColumnHeaderTemplate" inherits="ColumnDisplayButtonShortTemplate" virtual="true">
		<Size x="10" y="19"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Arrow" atlas="auctionhouse-ui-sortarrow" useAtlasSize="true" hidden="true">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Text" relativePoint="RIGHT" x="3" y="-2"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Button>
</Ui>
